#!/usr/bin/env bash
set -euo pipefail

backup_dir=/var/backups/hosseintalab
today=$(date -u +%F)

test -d "$backup_dir"
test -O "$backup_dir"
pg_dump --format=custom --no-owner --file="$backup_dir/hosseintalab-$today.dump" hosseintalab
find "$backup_dir" -maxdepth 1 -type f -name 'hosseintalab-*.dump' -mtime +14 -delete
